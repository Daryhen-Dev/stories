{
  "name": "@stories/stories-embed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:esm && pnpm run build:iife && pnpm run build:types && pnpm run build:verify",
    "build:esm": "vite build --mode esm",
    "build:iife": "vite build --mode iife",
    "build:types": "tsc -p tsconfig.build.json",
    "build:verify": "STORIES_EMBED_VERIFY_BUNDLE=1 vitest run src/bundle-size.test.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@stories/manifest-schema": "workspace:*",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "happy-dom": "20.14.5",
    "vite": "8.3.0"
  }
}
